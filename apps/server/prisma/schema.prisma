generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  DONE
  IN_PROGRESS
  PENDING
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  username       String           @unique
  email          String           @unique
  password       String?
  provider       AuthProvider     @default(EMAIL)
  createdAt      DateTime         @default(now())
  tasksCollections TasksCollection[]
  habits         Habit[]
  badHabits      BadHabitTimer[]
  categories     Category[]

  @@map("users")
}

model TasksCollection {
  tasksId   String   @id @default(uuid()) @db.Uuid
  tasksName String
  details   String
  created   DateTime @default(now())
  due       DateTime
  updated   DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid

  tasks     Task[]

  @@map("tasks_collection")
}
model Task {
  taskId     String          @id @default(uuid()) @db.Uuid
  tasksId    String          @db.Uuid
  taskName   String
  created    DateTime        @default(now())
  due        DateTime
  updated    DateTime        @updatedAt
  status     TaskStatus      @default(PENDING)
  tags       String[]
  details    String?
  subClassId String?         @db.Uuid
  parent     Task?           @relation("SubTasks", fields: [subClassId], references: [taskId])
  subTasks   Task[]          @relation("SubTasks")
  collection TasksCollection @relation(fields: [tasksId], references: [tasksId], onDelete: Cascade)

  @@map("task")
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits    Habit[]

  @@unique([userId, name])  // Unique category name per user
  @@index([userId])
}

model Habit {
  id          String    @id @default(uuid()) @db.Uuid
  habitName   String
  details     String?
  categoryId  String?   @db.Uuid          // <-- foreign key field for relation
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  userId    String    @db.Uuid

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  contributions HabitContribution[]

  @@unique([userId, habitName])
  @@index([userId])
  @@index([categoryId])
}
model HabitContribution {
  habitId   String   @db.Uuid
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, date])
}

model BadHabitTimer {
  id                     String   @id @default(uuid())
  userId                 String   @db.Uuid
  habitName              String
  details                String?

  createdAt              DateTime @default(now())

  lastRelapseAt          DateTime?
  longestStreakSeconds   Int
  relapsesCount          Int

  user                   User     @relation(fields: [userId], references: [id])

  @@unique([habitName])
  @@index([userId])
}

