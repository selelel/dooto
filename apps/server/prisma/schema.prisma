generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  username       String           @unique
  email          String           @unique
  password       String?
  provider       AuthProvider     @default(EMAIL)
  createdAt      DateTime         @default(now())
  tasksCollections TasksCollection[]

  @@map("users")
}

model TasksCollection {
  tasksId   String   @id @default(uuid()) @db.Uuid
  tasksName String
  details   String
  created   DateTime @default(now())
  due       DateTime
  updated   DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid

  tasks     Task[]

  @@map("tasks_collection")
}
model Task {
  taskId     String          @id @default(uuid()) @db.Uuid
  tasksId    String          @db.Uuid
  taskName   String
  created    DateTime        @default(now())
  due        DateTime
  updated    DateTime        @updatedAt
  status     TaskStatus      @default(PENDING)
  tags       String[]
  details    String?
  subClassId String?         @db.Uuid
  parent     Task?           @relation("SubTasks", fields: [subClassId], references: [taskId])
  subTasks   Task[]          @relation("SubTasks")
  collection TasksCollection @relation(fields: [tasksId], references: [tasksId], onDelete: Cascade)

  @@map("task")
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

enum TaskStatus {
  DONE
  IN_PROGRESS
  PENDING
}

enum AuthProvider {
  EMAIL
  GOOGLE
}
